# ---------------------------------------------------------------------------
# stock-ai environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and MUST NOT
# be committed. Every setting here is read by backend/config.py.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL ---
# These values must match docker-compose.yml when using the local stack.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stockai
POSTGRES_USER=stockai
POSTGRES_PASSWORD=change_me_locally

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# Data source credentials
#
# INTENTIONALLY EMPTY. No market-data, fundamental-data, or news provider has
# been selected yet. Providers must be chosen only after their licence terms,
# redistribution rules, and rate limits have been reviewed (CLAUDE.md Rule 8).
# Add keys here as `<PROVIDER>_API_KEY=` once a provider is approved.
# ---------------------------------------------------------------------------
